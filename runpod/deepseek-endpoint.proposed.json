{
  "name": "family-ai-reasoning-deepseek",
  "image": "runpod/worker-v1-vllm:v2.30.1",
  "type": "QUEUE",
  "flashboot": "FLASHBOOT",
  "disk": 60,
  "gpu": {"count": 1, "minCudaVersion": "13.0", "pools": ["AMPERE_48"]},
  "dataCenterIds": ["EU-SE-1", "EUR-IS-2"],
  "workers": {"min": 0, "max": 1, "idleTimeout": 60},
  "scaling": {"type": "QUEUE_DELAY", "queueDelay": 1},
  "timeout": 600000,
  "env": {
    "MODEL_NAME": "deepseek-ai/DeepSeek-R1-Distill-Qwen-14B",
    "OPENAI_SERVED_MODEL_NAME_OVERRIDE": "family-deepseek",
    "MAX_MODEL_LEN": "16384",
    "MAX_NUM_BATCHED_TOKENS": "2048",
    "MAX_NUM_SEQS": "2",
    "GPU_MEMORY_UTILIZATION": "0.90",
    "ENABLE_PREFIX_CACHING": "true",
    "REASONING_PARSER": "deepseek_r1",
    "ENFORCE_EAGER": "true"
  }
}
