{
  "name": "family-ai-brain-fast",
  "image": "runpod/worker-v1-vllm:v2.30.1",
  "type": "QUEUE",
  "flashboot": "FLASHBOOT",
  "disk": 40,
  "gpu": {
    "count": 1,
    "minCudaVersion": "13.0",
    "pools": ["AMPERE_24"]
  },
  "dataCenterIds": ["EU-SE-1", "EUR-IS-2"],
  "workers": {"min": 0, "max": 1, "idleTimeout": 60},
  "scaling": {"type": "QUEUE_DELAY", "queueDelay": 1},
  "timeout": 600000,
  "env": {
    "MODEL_NAME": "Qwen/Qwen3.5-9B",
    "OPENAI_SERVED_MODEL_NAME_OVERRIDE": "family-fast",
    "MAX_MODEL_LEN": "8192",
    "MAX_NUM_BATCHED_TOKENS": "2048",
    "MAX_NUM_SEQS": "4",
    "GPU_MEMORY_UTILIZATION": "0.92",
    "ENABLE_PREFIX_CACHING": "true",
    "ENABLE_AUTO_TOOL_CHOICE": "true",
    "TOOL_CALL_PARSER": "qwen3_coder",
    "REASONING_PARSER": "qwen3",
    "LIMIT_MM_PER_PROMPT": "{\"image\":1,\"video\":0}",
    "COMPILATION_CONFIG": "{\"mode\":0,\"cudagraph_mode\":\"FULL_DECODE_ONLY\",\"cudagraph_capture_sizes\":[1,2,4]}"
  }
}
